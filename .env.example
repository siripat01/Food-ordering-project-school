APP_ENV=development
MONGODB_URI=mongodb://mongo:27017
MONGODB_USERS_DATABASE=Users
MONGODB_PRODUCTS_DATABASE=Products
MONGODB_ORDERS_DATABASE=Orders
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=food-ordering-api
JWT_AUDIENCE=food-ordering-web
ACCESS_TOKEN_TTL_MINUTES=60
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
SSE_HEARTBEAT_SECONDS=15
SSE_SUBSCRIBER_QUEUE_SIZE=50

LINE_ENABLED=false
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_LOGIN_CHANNEL_ID=replace-with-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=replace-with-line-login-channel-secret
LINE_REDIRECT_URI=http://localhost:8000/api/v1/auth/line/callback

LLM_ENABLED=false
LLM_API_KEY=replace-with-llm-provider-api-key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=ordering-assistant
LLM_PRIMARY_MODEL=deepseek/deepseek-v4-flash
LLM_COMPLEX_MODEL=deepseek/deepseek-v4-pro
LLM_COMPLEXITY_ROUTING_ENABLED=true
LLM_COMPLEXITY_CLASSIFIER=heuristic
LLM_COMPLEXITY_CLASSIFIER_TIMEOUT_MS=1500
LLM_COMPLEXITY_KEYWORDS=["หลายรายการ","หลายเมนู","อย่างละ","แยกหมายเหตุ","แพ้อาหาร","ข้อจำกัด","งบประมาณ","เปรียบเทียบ","multiple items","dietary restriction","allergy","compare"]
LLM_FALLBACK_MODELS=[]
LLM_ROUTING_STRATEGY=simple-shuffle
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_ITERATIONS=4
LLM_MAX_OUTPUT_TOKENS=800
LLM_MEMORY_MESSAGES=12
LLM_MEMORY_TTL_MINUTES=30
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=60
LLM_CACHE_MAX_ENTRIES=200

# MiniMax OpenAI-compatible alternative (replace the matching LLM values above):
# LLM_API_BASE=https://api.minimax.io/v1
# LLM_PRIMARY_MODEL=minimax/MiniMax-M2.7
# LLM_COMPLEX_MODEL=minimax/MiniMax-M2.7
# LLM_COMPLEXITY_ROUTING_ENABLED=false

RECOMMENDER_ENABLED=false
RECOMMENDER_URL=http://localhost:8080
RECOMMENDER_TIMEOUT_SECONDS=3
RECOMMENDER_MODE=local
RECOMMENDATION_USER_REF_SECRET=replace-with-dedicated-recommendation-secret
RECOMMENDATION_USER_REF_KEY_VERSION=v1
RECOMMENDATION_USER_REF_PREVIOUS_SECRETS={}
RECOMMENDATION_EVENT_RETENTION_DAYS=180
RECOMMENDATION_SLATE_RETENTION_DAYS=7
RECOMMENDATION_DAILY_IMPRESSION_CAP=10
RECOMMENDATION_DAILY_CLICK_CAP=5
RECOMMENDATION_DAILY_ADD_TO_CART_CAP=3
RECOMMENDATION_ITEM_ITEM_ROLLOUT_PERCENT=0
RECOMMENDATION_MODEL_POLL_SECONDS=30
RECOMMENDATION_RESULT_CACHE_TTL_SECONDS=30
RECOMMENDATION_RESULT_CACHE_MAX_ENTRIES=500
RECOMMENDATION_MODEL_MAX_PRODUCTS=10000
RECOMMENDATION_MODEL_MAX_BYTES=10485760
RECOMMENDATION_PROFILE_ORDER_LIMIT=50
RECOMMENDATION_PROFILE_PRODUCT_LIMIT=20

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
