# Copy this file to deploy/backend.env on the production VM.
# Replace every placeholder for an enabled integration and never commit the result.
APP_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_USERS_DATABASE=HiwKawProd
MONGODB_PRODUCTS_DATABASE=HiwKawProd
MONGODB_ORDERS_DATABASE=HiwKawProd

JWT_SECRET=replace-with-generated-random-secret-at-least-32-characters
JWT_ISSUER=hiwkaw-api
JWT_AUDIENCE=hiwkaw-web
ACCESS_TOKEN_TTL_MINUTES=60

RECOMMENDATION_USER_REF_SECRET=replace-with-different-generated-random-secret-at-least-32-characters
RECOMMENDATION_USER_REF_KEY_VERSION=v1
RECOMMENDATION_USER_REF_PREVIOUS_SECRETS={}

FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
CORS_ORIGINS=["https://app.example.com"]
COOKIE_SECURE=true

LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=false
SSE_HEARTBEAT_SECONDS=15
SSE_SUBSCRIBER_QUEUE_SIZE=50

LINE_ENABLED=false
LINE_CHANNEL_SECRET=<line-channel-secret>
LINE_CHANNEL_ACCESS_TOKEN=<line-channel-access-token>
LINE_LOGIN_CHANNEL_ID=<line-login-channel-id>
LINE_LOGIN_CHANNEL_SECRET=<line-login-channel-secret>
LINE_REDIRECT_URI=https://api.example.com/api/v1/auth/line/callback

LLM_ENABLED=false
LLM_API_KEY=<llm-provider-api-key>
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=ordering-assistant
LLM_PRIMARY_MODEL=deepseek/deepseek-v4-flash
LLM_COMPLEX_MODEL=deepseek/deepseek-v4-pro
LLM_COMPLEXITY_ROUTING_ENABLED=true
LLM_COMPLEXITY_CLASSIFIER=heuristic
LLM_FALLBACK_MODELS=[]
LLM_ROUTING_STRATEGY=simple-shuffle
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_ITERATIONS=4
LLM_MAX_OUTPUT_TOKENS=800
LLM_MEMORY_MESSAGES=12
LLM_MEMORY_TTL_MINUTES=30
LLM_CACHE_ENABLED=false

RECOMMENDER_ENABLED=false
RECOMMENDER_MODE=local
RECOMMENDATION_ITEM_ITEM_ROLLOUT_PERCENT=0
