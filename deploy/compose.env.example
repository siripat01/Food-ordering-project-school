# Configure these values in the Dokploy Compose Environment.
# Prefer the digest printed in the GitHub Actions job summary.
BACKEND_IMAGE=ghcr.io/siripat01/food-ordering-project-school-backend@sha256:<image-digest>

# Private monitoring stack
PROMETHEUS_RETENTION=15d
METRICS_TOKEN_FILE=deploy/secrets/metrics-token
GRAFANA_BIND_ADDRESS=100.64.0.10
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generated-grafana-password>
ALERTMANAGER_WEBHOOK_URL=https://monitoring.example.invalid/alerts
